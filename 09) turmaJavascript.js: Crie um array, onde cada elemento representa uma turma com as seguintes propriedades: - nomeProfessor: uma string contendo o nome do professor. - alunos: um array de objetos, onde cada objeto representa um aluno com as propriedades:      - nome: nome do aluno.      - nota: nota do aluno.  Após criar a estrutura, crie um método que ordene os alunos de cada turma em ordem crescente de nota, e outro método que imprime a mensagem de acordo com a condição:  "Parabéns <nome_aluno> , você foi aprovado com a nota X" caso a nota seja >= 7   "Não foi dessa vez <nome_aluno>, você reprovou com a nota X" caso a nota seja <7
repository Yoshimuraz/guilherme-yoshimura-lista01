let turmas = [
    {
        nomeProfessor: "Carlos",
        alunos: [
            { nome: "João", nota: 8.5 },
            { nome: "Maria", nota: 6.5 },
            { nome: "Pedro", nota: 9.0 },
            { nome: "Ana", nota: 5.5 }
        ]
    },
    {
        nomeProfessor: "Fernanda",
        alunos: [
            { nome: "Lucas", nota: 7.5 },
            { nome: "Juliana", nota: 6.0 },
            { nome: "Rafael", nota: 8.0 },
            { nome: "Beatriz", nota: 4.5 }
        ]
    }
];

function ordenarAlunos(turma) {
    turma.alunos.sort((a, b) => a.nota - b.nota);
}

function verificarResultado(turma) {
    for (let aluno of turma.alunos) {
        if (aluno.nota >= 7) {
            console.log(`Parabéns ${aluno.nome}, você foi aprovado com a nota ${aluno.nota}`);
        } else {
            console.log(`Não foi dessa vez ${aluno.nome}, você reprovou com a nota ${aluno.nota}`);
        }
    }
}

for (let turma of turmas) {
    ordenarAlunos(turma);
    verificarResultado(turma);
}
